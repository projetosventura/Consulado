POSTGRES_USER=consulado
POSTGRES_PASSWORD=consulado
POSTGRES_DB=rifas
POSTGRES_PORT=5432

DATABASE_URL=postgresql://consulado:consulado@postgres:5432/rifas

API_PORT=3000
JWT_SECRET=troque-este-segredo-em-producao
FRONTEND_ORIGIN=http://localhost:5173
API_PUBLIC_URL=http://localhost:3000
# No ar, o nginx do compose de produção encaminha /api para a API.
# Na EC2 use o IP público ou o domínio, com https quando o certificado existir:
# FRONTEND_ORIGIN=http://SEU_IP
# API_PUBLIC_URL=http://SEU_IP
VITE_API_URL=/api

# Deixe vazio para testar localmente sem credencial.
# Com token do Mercado Pago (teste), o PIX real de sandbox é gerado.
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=

RESERVATION_MINUTES=15
ADMIN_EMAIL=admin@consulado.local
ADMIN_PASSWORD=admin123

# Só se o Vite rodar na sua máquina, fora do Docker, apontando para a API local:
# VITE_API_URL=http://localhost:3000/api
